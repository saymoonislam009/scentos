# ─── Supabase ───
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only, never exposed to the browser. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Admin panel ───
# Single shared secret for the private /admin dashboard. Change this before
# any real deployment — it's a one-operator gate, not a full auth system.
ADMIN_SECRET=faltuscentos
